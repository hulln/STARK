# meta::speakerCount = 0
# meta::summary = This guide to flirting via instant messaging suggests starting bu saying 'hi' and asking about someone's day, asking for help with work or school, or asking about their username, then moving on to musical likes and dislikes and making jokes, while avoiding self-deprecation, sappiness, excessive flattery or jokes at other people's expense.
# meta::title = How to Flirt Through Instant Messaging
# newpar
# newpar_block = head rend:::"bold" (1 s)
# sent_id = GUM_whow_flirt-1
# s_prominence = 2
# s_type = inf
